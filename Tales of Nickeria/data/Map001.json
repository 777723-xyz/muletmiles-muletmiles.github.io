{"id":3,"name":"Intro Scene Still","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":203,"indent":0,"parameters":[9,0,13,6,0]},{"code":121,"indent":0,"parameters":[14,14,0]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["As its player descends from the stairs, you realize"]},{"code":401,"indent":0,"parameters":["it is to be one of your traveling companions."]},{"code":203,"indent":0,"parameters":[8,0,8,12,0]},{"code":121,"indent":0,"parameters":[15,15,0]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Sure enough, your next traveling companion, a dog,"]},{"code":401,"indent":0,"parameters":["approaches into the tavern and seats himself (like"]},{"code":401,"indent":0,"parameters":["a good boy) across from you."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Given that you don't know what kind of journeying"]},{"code":401,"indent":0,"parameters":["awaits this merry band of adventurers, you find it"]},{"code":401,"indent":0,"parameters":["fitting to introduce yourself."]},{"code":231,"indent":0,"parameters":[1,"Actor_6",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\S[12]Well met, fellow travelers!\\!\\S[13] It's great"]},{"code":401,"indent":0,"parameters":["to have such well-found companions.\\!\\S[14] I serve"]},{"code":401,"indent":0,"parameters":["as a \"Nick\" Malk...\\!\\S[15] powerful beings strong in"]},{"code":401,"indent":0,"parameters":["the ways of...\\!\\S[17] friendship!"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\S[18]I'm sure this journey will be met with success!"]},{"code":235,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[1,"Actor_7",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\S[19]*Borf!*"]},{"code":235,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[1,"Actor_8",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\S[20]*Chuckle* And what a charming little array of"]},{"code":401,"indent":0,"parameters":["characters we are, eh?\\!\\S[21] I go by \"VelNick\" - a"]},{"code":401,"indent":0,"parameters":["name chosen by my wise ancestors.\\!\\S[22] My sword skills"]},{"code":401,"indent":0,"parameters":["should come in handy should trouble come our way."]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\S[23]The group exchanges warm and pleasant smiles.\\!\\S[24]"]},{"code":401,"indent":0,"parameters":["\"This bodes well,\" you think. \\!\\S[25]\"Not at all strange"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\S[26]The conversation lulls, and the barkeep \"Nick\" -"]},{"code":401,"indent":0,"parameters":["wearing a delightful smile - approaches your group."]},{"code":205,"indent":0,"parameters":[1,{"list":[{"code":14,"parameters":[0,2],"indent":null},{"code":1,"indent":null},{"code":3,"indent":null},{"code":0}],"repeat":false,"skippable":false,"wait":false}]},{"code":505,"indent":0,"parameters":[{"code":14,"parameters":[0,2],"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":1,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":3,"indent":null}]},{"code":101,"indent":0,"parameters":["People1",5,0,2]},{"code":401,"indent":0,"parameters":["\\S[27]Well, tarnation! Ain't ev'ry day we get a 'couple"]},{"code":401,"indent":0,"parameters":["o' fine lookin' adventurin' folk like yerselves! What,"]},{"code":401,"indent":0,"parameters":["pray tell, be the occasion?"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\S[28]She places drinks on the table as she talks."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\S[29]Boisterously, VelNick is the first to answer.\\!"]},{"code":401,"indent":0,"parameters":["\\S[30]The question"]},{"code":231,"indent":0,"parameters":[1,"Actor_8",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\S[31]But, for the treasure, of course!"]},{"code":235,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[1,"Actor_7",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\S[32]*Excited Borf!*"]},{"code":235,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[1,"Actor_8",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\S[33]Haha, even the dog is excited!"]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["People1",5,0,2]},{"code":401,"indent":0,"parameters":["\\S[34]Ahhh, work fer ol' Lord Nick, eh?"]},{"code":401,"indent":0,"parameters":["\\!\\S[35]Quite the task, ain't it?"]},{"code":205,"indent":0,"parameters":[1,{"list":[{"code":2,"indent":null},{"code":4,"indent":null},{"code":14,"parameters":[0,-2],"indent":null},{"code":0}],"repeat":false,"skippable":false,"wait":false}]},{"code":505,"indent":0,"parameters":[{"code":2,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":4,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":14,"parameters":[0,-2],"indent":null}]},{"code":231,"indent":0,"parameters":[1,"Actor_8",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\S[36]Perhaps, yes... \\!\\S[37]But, at le